# Copy to .env only for manual setup. scripts/start-backend.ps1 generates a random password.
# Never commit .env. SQL administrator password is never saved here.
DB_SERVER=sqlserver
DB_PORT=1433
DB_DATABASE=web_thoi_trang
DB_USER=endless_runtime
DB_PASSWORD=replace_with_a_long_random_password
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
# start-backend.ps1 generates and preserves a separate random session secret.
SESSION_SECRET=replace_with_at_least_32_random_characters
SESSION_COOKIE_SECURE=false
# Local defaults. Public API: set SECURE=true and SAMESITE=none together.
# none requires Secure; direct localhost HTTP still gets a separate Lax cookie.
SESSION_COOKIE_SAMESITE=lax
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://nguyenhoangphuc1711.github.io
TRUST_PROXY=0
# Tunnel: TRUST_PROXY=172.30.251.2 (only the dedicated cloudflared container).
# Tunnel network uses fixed IPs: cloudflared=172.30.251.2, backend=172.30.251.3.
# Start explicitly: docker compose --profile tunnel up -d cloudflared
CLOUDFLARE_TUNNEL_TOKEN=placeholder
